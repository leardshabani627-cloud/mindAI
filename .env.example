# Copy this file to .env.local and fill in your key. Never commit .env.local.
#
# Default: Google Gemini free tier. Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# Alternative: Groq free tier (https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
