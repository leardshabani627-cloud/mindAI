# Copy this file to .env.local and fill it in. Never commit .env.local.
# On Vercel, add the same variables under Project Settings > Environment Variables.

# --- AI provider (server only). Any OpenAI-compatible API. Default: Groq free tier.
# Free key: https://console.groq.com/keys (also used for voice transcription with Whisper)
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# For reasoning models such as openai/gpt-oss-120b, "low" keeps replies quick and natural.
# Leave it out for providers that don't support it.
LLM_REASONING_EFFORT=low
# Alternative: Google Gemini (https://aistudio.google.com/apikey). Its free tier isn't available in every country.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash

# --- Supabase: Project Settings > API
# Project URL, with no path on the end (not .../rest/v1/).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The public "anon" / "publishable" key. Safe to expose: Row Level Security protects the data.
# Do NOT put the service_role / secret key anywhere in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Optional: your own background photo (one you have the rights to), placed in /public.
# NEXT_PUBLIC_BACKGROUND_IMAGE=/background.jpg
